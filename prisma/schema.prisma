generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum TicketStatus {
  WAITING
  CALLED
  SERVING
  COMPLETED
  CANCELLED
  MISSED
}

enum DeskStatus {
  OPEN
  PAUSED
  CLOSED
}

model Service {
  id         String   @id @default(uuid())
  name       String
  prefix     String   @unique
  avgMinutes Float
  active     Boolean  @default(true)
  nextNumber Int      @default(0)
  desks      Desk[]
  tickets    Ticket[]
}

model Account {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  profile      String         @default("standard")
  highContrast Boolean        @default(false)
  largeText    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AccountSession[]
  tickets      Ticket[]
}

model AccountSession {
  id        String   @id @default(uuid())
  accountId String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, expiresAt])
}

model Desk {
  id         String     @id @default(uuid())
  name       String
  buildingId String
  floor      Int
  locationId String
  status     DeskStatus @default(CLOSED)
  services   Service[]
  tickets    Ticket[]
}

model Ticket {
  id        String       @id @default(uuid())
  number    String       @unique
  sequence  Int
  serviceId String
  service   Service      @relation(fields: [serviceId], references: [id])
  accountId String?
  account   Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  status    TicketStatus @default(WAITING)
  profile   String       @default("standard")
  tokenHash String
  deskId    String?
  desk      Desk?        @relation(fields: [deskId], references: [id])
  createdAt DateTime     @default(now())
  calledAt  DateTime?
  startedAt DateTime?
  endedAt   DateTime?
  helpSummary String?
  helpRequirements String?
  requesterLocationId String?
  claimedById String?
  claimedBy AdminSession? @relation(fields: [claimedById], references: [id])
  claimedAt DateTime?
  helpCompletedAt DateTime?

  @@unique([serviceId, sequence])
  @@index([serviceId, status, sequence])
  @@index([deskId, status])
  @@index([accountId, createdAt])
}

model AdminSession {
  id String @id @default(uuid())
  name String
  tokenHash String @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  tickets Ticket[]
}
